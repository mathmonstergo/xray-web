# 本机使用保持以下默认值；扩大 Web 监听范围时必须设置密码。
WEB_HOST=127.0.0.1
WEB_PORT=2017
WEB_USERNAME=admin
WEB_PASSWORD=
WEB_ALLOWED_HOSTS=localhost,127.0.0.1,::1
PROXY_LISTEN_HOST=127.0.0.1

# 兼容现有系统级 Xray 安装；新安装推荐 scripts/prepare_local.py。
XRAY_BIN=/usr/local/bin/xray
XRAY_SERVICE_NAME=xray
XRAY_SYSTEMD_USER=0
XRAY_CONFIG_PATH=/etc/xray/config.json
XRAY_BACKUP_PATH=/etc/xray/config.json.bak
XRAY_LOG_DIR=/var/log/xray

SOCKS_PORT=20170
HTTP_PROXY_PORT=20171
HTTP_ROUTING_PORT=20172
SPEED_TEST_CONCURRENCY=1
DELAY_TEST_CONCURRENCY=4
